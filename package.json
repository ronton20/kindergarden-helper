{
  "name": "kindergarten-helper",
  "version": "2.0.0",
  "description": "A very simple bilingual (Hebrew/English) desktop helper for a kindergarten teacher: name cards, attendance sheets, and graduation photos.",
  "main": "main.js",
  "author": "Ron Ariel",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.tamar.kindergartenhelper",
    "productName": "Kindergarten Helper",
    "files": [
      "main.js",
      "splash.js",
      "splash.html",
      "updater.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ronton20",
        "repo": "kindergarden-helper",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Kindergarten Helper",
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "KindergardenHelper_Setup_v${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "עוזר הגן · Kindergarten Helper",
      "uninstallDisplayName": "עוזר הגן · Kindergarten Helper",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
