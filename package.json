{
  "name": "kindergarten-helper",
  "version": "2.2.1",
  "description": "A very simple bilingual (Hebrew/English) desktop helper for a kindergarten teacher: name cards, attendance sheets, and graduation photos.",
  "main": "main.js",
  "author": "Ron Ariel",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:characterization": "electron tests/characterization/run.js"
  },
  "build": {
    "appId": "com.tamar.kindergartenhelper",
    "productName": "Kindergarten Helper",
    "files": [
      "main.js",
      "preload.js",
      "downloads.js",
      "splash.js",
      "splash.html",
      "updater.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ronton20",
        "repo": "kindergarden-helper",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Kindergarten Helper",
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "KindergardenHelper_Setup_v${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "עוזר הגן · Kindergarten Helper",
      "uninstallDisplayName": "עוזר הגן · Kindergarten Helper",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
